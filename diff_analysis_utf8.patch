+def get_map_prompt(query: str, retrieved_chunks: str, batch_id: str) -> str:
+    """Build the map-phase prompt for a single document batch."""
+    return f"""SYSTEM:
+
+You are analyzing a subset of documents as part of a larger corpus-wide analysis.
+
+You MUST:
+
+* Only use information from provided context
+* Extract relevant insights related to the user question
+* Identify evidence explicitly
+* Avoid assumptions
+* Return structured JSON
+
+You are NOT producing the final answer yet.
+
+---
+
+USER:
+
+User Question:
+{query}
+
+Context from current document batch:
+{retrieved_chunks}
+
+Instructions:
+
+1. Extract all relevant insights related to the question.
+2. List supporting evidence snippets.
+3. Identify contradictions if any.
+4. Assess confidence level for this batch (high, medium, low).
+5. DO NOT summarize globally.
+6. DO NOT hallucinate.
+
+Return JSON:
+
+{{
+"batch_id": "{batch_id}",
+"key_findings": [],
+"supporting_evidence": [],
+"contradictions": [],
+"confidence": "high|medium|low",
+"partial_answer": "detailed explanation from this batch only"
+}}
+"""
+
+
+def get_reduce_prompt(query: str, batch_outputs_json: str) -> str:
+    """Build the reduce-phase prompt for final synthesis across all batches."""
+    return f"""SYSTEM:
+
+You are performing a full-corpus synthesis across multiple document batches.
+
+Each batch contains partial findings extracted independently.
+
+You must:
+
+* Consider ALL batch outputs
+* Merge overlapping findings
+* Resolve contradictions
+* Weigh confidence levels
+* Produce a unified, comprehensive answer
+
+Be analytical and structured.
+
+---
+
+USER:
+
+User Question:
+{query}
+
+Batch Findings:
+{batch_outputs_json}
+
+Instructions:
+
+1. Merge all relevant findings.
+2. Remove duplicate insights.
+3. Highlight cross-batch consensus.
+4. Explicitly address contradictions.
+5. Provide a final comprehensive answer.
+6. Provide an overall confidence score.
+
+Return JSON:
+
+{{
+"final_answer": "...",
+"key_consensus_points": [],
+"resolved_contradictions": [],
+"overall_confidence": "high|medium|low"
+}}
+"""
