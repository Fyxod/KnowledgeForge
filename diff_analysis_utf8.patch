new file mode 100644
index 0000000..e1ec23e
--- /dev/null
+++ b/core/exhaustive_analysis.py
@@ -0,0 +1,415 @@
+"""
+Exhaustive Analysis Pipeline ΓÇö Map/Reduce over ALL documents in a thread.
+
+This module implements the exhaustive query mode which:
+1. Loads ALL parsed documents for a user/thread
+2. Batches them by BATCH_DOCUMENT_LIMIT
+3. For each batch: chunks text ΓåÆ retrieves + reranks ΓåÆ LLM map prompt ΓåÆ structured output
+4. Reduces all batch outputs into a single synthesized answer
+5. Handles token-safety with recursive reduction
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import time
+from typing import Any, Dict, List, Optional
+
+import aiofiles
+
+from core.constants import (
+    BATCH_DOCUMENT_LIMIT,
+    CONTEXT_LIMIT,
+    GPU_EXHAUSTIVE_LLM,
+    MAX_TOTAL_CHUNKS,
+)
+from core.embeddings.retriever import rerank_chunks
+from core.embeddings.vectorstore import chunk_page_text, SEARCH_DOCUMENT_PREFIX
+from core.llm.client import invoke_llm
+from core.llm.output_schemas.exhaustive_outputs import (
+    ExhaustiveMapOutput,
+    ExhaustiveReduceOutput,
+)
+from core.llm.prompts.exhaustive_prompts import get_map_prompt, get_reduce_prompt
+from core.models.document import Document
+from core.utils.count_tokens import count_tokens
+
+logger = logging.getLogger(__name__)
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+
+def _chunk_list(lst: list, size: int) -> List[list]:
+    """Split *lst* into sub-lists of at most *size* elements."""
+    return [lst[i : i + size] for i in range(0, len(lst), size)]
+
+
+async def _load_all_parsed_documents(user_id: str, thread_id: str) -> List[Document]:
+    """Read every ``*.json`` file in the thread's ``parsed/`` directory
+    and return them as validated ``Document`` models."""
+    parsed_dir = os.path.join("data", user_id, "threads", thread_id, "parsed")
+    if not os.path.isdir(parsed_dir):
+        return []
+
+    documents: List[Document] = []
+    for filename in sorted(os.listdir(parsed_dir)):
+        if not filename.endswith(".json"):
+            continue
+        file_path = os.path.join(parsed_dir, filename)
+        try:
+            async with aiofiles.open(file_path, "r", encoding="utf-8") as f:
+                content = await f.read()
+            data = json.loads(content)
+            if isinstance(data, dict) and "id" in data:
+                documents.append(Document.model_validate(data))
+        except Exception as exc:
+            logger.warning("Failed to load parsed document %s: %s", file_path, exc)
+    return documents
+
+
+# ---------------------------------------------------------------------------
+# Map Phase ΓÇö process a single batch
+# ---------------------------------------------------------------------------
+
+
+async def process_batch(
+    batch_docs: List[Document],
+    query: str,
+    batch_id: str,
+    sio=None,
+    sid: Optional[str] = None,
+) -> ExhaustiveMapOutput:
+    """Run retrieval + reranking + LLM map prompt for one document batch.
+
+    Parameters
+    ----------
+    batch_docs : list[Document]
+        The documents assigned to this batch.
+    query : str
+        The user question.
+    batch_id : str
+        Human-readable batch identifier (e.g. ``"batch_3/8"``).
+    sio : optional socketio.AsyncServer
+        If provided, emits ``exhaustive_progress`` events.
+    sid : optional str
+        Socket.IO session id for progress events.
+    """
+
+    # 1. Combine text from all docs ΓåÆ chunk
+    all_chunks: List[Dict[str, Any]] = []
+    for doc in batch_docs:
+        for page in doc.content:
+            raw_chunks = chunk_page_text(page.text)
+            for idx, chunk_text in enumerate(raw_chunks):
+                enriched = (
+                    f"{SEARCH_DOCUMENT_PREFIX}Document: {doc.title}\n"
+                    f"Page {page.number}\n\n{chunk_text}"
+                )
+                all_chunks.append(
+                    {
+                        "page_content": enriched,
+                        "metadata": {
+                            "document_id": doc.id,
+                            "title": doc.title,
+                            "file_name": doc.file_name,
+                            "page_no": page.number,
+                            "chunk_index": idx,
+                        },
+                    }
+                )
+
+    if not all_chunks:
+        # Empty batch ΓÇö return a minimal result
+        return ExhaustiveMapOutput(
+            batch_id=batch_id,
+            key_findings=[],
+            supporting_evidence=[],
+            contradictions=[],
+            confidence="low",
+            partial_answer="No content available in this batch.",
+        )
+
+    # 2. Rerank with cross-encoder + MMR diversity
+    top_k = min(len(all_chunks), MAX_TOTAL_CHUNKS)
+    reranked = rerank_chunks(query, all_chunks, top_k=top_k)
+
+    # 3. Build context string from top reranked chunks, enforcing token budget.
+    #    Reserve ~20% of the context window for the map prompt template + LLM
+    #    output tokens.  Drop lowest-ranked chunks (from the tail) until the
+    #    assembled context fits.
+    chunk_budget = int(CONTEXT_LIMIT * 0.80)
+
+    # Start with all reranked chunks and shrink if needed
+    selected = list(reranked)
+    while selected:
+        context_parts = [c.get("page_content", "") for c in selected]
+        retrieved_chunks_text = "\n\n---\n\n".join(context_parts)
+        token_count = count_tokens(retrieved_chunks_text)
+        if token_count <= chunk_budget:
+            break
+        # Drop the last chunk (lowest relevance after reranking)
+        selected.pop()
+        logger.debug(
+            "[Exhaustive] Trimmed to %d chunks (%d tokens > %d budget)",
+            len(selected),
+            token_count,
+            chunk_budget,
+        )
+
+    if not selected:
+        # Edge case: even a single chunk overflows ΓÇö take first chunk truncated
+        retrieved_chunks_text = reranked[0].get("page_content", "")[: chunk_budget * 4]
+        logger.warning("[Exhaustive] Single chunk exceeds budget, hard-truncating")
+    else:
+        context_parts = [c.get("page_content", "") for c in selected]
+        retrieved_chunks_text = "\n\n---\n\n".join(context_parts)
+
+    # 4. Build MAP prompt and invoke LLM
+    prompt = get_map_prompt(query, retrieved_chunks_text, batch_id)
+
+    result: ExhaustiveMapOutput = await invoke_llm(
+        gpu_model=GPU_EXHAUSTIVE_LLM.model,
+        response_schema=ExhaustiveMapOutput,
+        contents=prompt,
+        port=GPU_EXHAUSTIVE_LLM.port,
+    )
+
+    logger.info(
+        "[Exhaustive] Batch %s done ΓÇö confidence=%s, findings=%d",
+        batch_id,
+        result.confidence,
+        len(result.key_findings),
+    )
+    return result
+
+
+# ---------------------------------------------------------------------------
+# Reduce Phase ΓÇö synthesize all batch outputs
+# ---------------------------------------------------------------------------
+
+
+async def run_reduce_phase(
+    batch_outputs: List[ExhaustiveMapOutput],
+    query: str,
+) -> ExhaustiveReduceOutput:
+    """Synthesize all batch outputs into a single answer.
+
+    If the serialized batch outputs exceed the token budget, the function
+    applies **recursive reduction**: groups of batch outputs are reduced
+    first, then those intermediate results are reduced again, repeating
+    until a single output remains.
+    """
+
+    serializable = [b.model_dump() for b in batch_outputs]
+
+    # Token-safety: recursive reduction if payload is too large
+    # Reserve ~20 % of the context window for the reduce prompt + format instructions
+    budget = int(CONTEXT_LIMIT * 0.80)
+
+    while True:
+        payload_json = json.dumps(serializable, ensure_ascii=False)
+        token_count = count_tokens(payload_json)
+
+        if token_count <= budget or len(serializable) <= 1:
+            break
+
+        # Group into sub-groups of 4 and reduce each group first
+        groups = _chunk_list(serializable, 4)
+        logger.info(
+            "[Exhaustive] Reducing %d batch outputs (%d tokens) ΓåÆ %d groups",
+            len(serializable),
+            token_count,
+            len(groups),
+        )
+        intermediate: List[dict] = []
+        for g_idx, group in enumerate(groups):
+            group_json = json.dumps(group, ensure_ascii=False)
+            prompt = get_reduce_prompt(query, group_json)
+
+            result: ExhaustiveReduceOutput = await invoke_llm(
+                gpu_model=GPU_EXHAUSTIVE_LLM.model,
+                response_schema=ExhaustiveReduceOutput,
+                contents=prompt,
+                port=GPU_EXHAUSTIVE_LLM.port,
+            )
+            # Convert back to a batch-like dict so the next iteration can
+            # reduce further using the same shape.
+            intermediate.append(
+                {
+                    "batch_id": f"intermediate_{g_idx}",
+                    "key_findings": result.key_consensus_points,
+                    "supporting_evidence": [],
+                    "contradictions": result.resolved_contradictions,
+                    "confidence": result.overall_confidence,
+                    "partial_answer": result.final_answer,
+                }
+            )
+        serializable = intermediate
+
+    # Final reduce call
+    payload_json = json.dumps(serializable, ensure_ascii=False)
+    prompt = get_reduce_prompt(query, payload_json)
+
+    final: ExhaustiveReduceOutput = await invoke_llm(
+        gpu_model=GPU_EXHAUSTIVE_LLM.model,
+        response_schema=ExhaustiveReduceOutput,
+        contents=prompt,
+        port=GPU_EXHAUSTIVE_LLM.port,
+    )
+    return final
+
+
+# ---------------------------------------------------------------------------
+# Top-Level Orchestrator
+# ---------------------------------------------------------------------------
+
+
+async def run_exhaustive_analysis(
+    query: str,
+    user_id: str,
+    thread_id: str,
+    sio=None,
+    sid: Optional[str] = None,
+) -> Dict[str, Any]:
+    """Entry point for the exhaustive analysis pipeline.
+
+    Returns a dict matching the normal query-route response shape so the
+    caller can merge it directly into the HTTP response.
+    """
+    start = time.time()
+
+    # ΓöÇΓöÇ Step A: Load ALL parsed documents ΓöÇΓöÇ
+    all_docs = await _load_all_parsed_documents(user_id, thread_id)
+    if not all_docs:
+        return {
+            "answer": "No documents found for exhaustive analysis. Please upload documents first.",
+            "sources": {"documents_used": [], "web_used": []},
+            "confidence_score": "low",
+            "exhaustive": True,
+        }
+
+    logger.info(
+        "[Exhaustive] Loaded %d documents for user=%s thread=%s",
+        len(all_docs),
+        user_id,
+        thread_id,
+    )
+
+    # ΓöÇΓöÇ Step B: Create document batches ΓöÇΓöÇ
+    doc_batches = _chunk_list(all_docs, BATCH_DOCUMENT_LIMIT)
+    total_batches = len(doc_batches)
+    logger.info(
+        "[Exhaustive] Created %d batches (limit=%d)",
+        total_batches,
+        BATCH_DOCUMENT_LIMIT,
+    )
+
+    # Emit initial progress
+    if sio and sid:
+        await sio.emit(
+            "exhaustive_progress",
+            {"batch": 0, "total": total_batches, "status": "starting"},
+            room=sid,
+        )
+
+    # ΓöÇΓöÇ Step C: Map phase ΓÇö sequential execution ΓöÇΓöÇ
+    batch_outputs: List[ExhaustiveMapOutput] = []
+    for idx, batch in enumerate(doc_batches):
+        batch_id = f"batch_{idx + 1}/{total_batches}"
+
+        # Emit progress
+        if sio and sid:
+            await sio.emit(
+                "exhaustive_progress",
+                {
+                    "batch": idx + 1,
+                    "total": total_batches,
+                    "status": f"Processing batch {idx + 1}/{total_batches}ΓÇª",
+                },
+                room=sid,
+            )
+
+        logger.info("[Exhaustive] Processing %s (%d docs)", batch_id, len(batch))
+        result = await process_batch(batch, query, batch_id, sio=sio, sid=sid)
+        batch_outputs.append(result)
+
+        # Log intermediate result for debugging
+        logger.debug(
+            "[Exhaustive] %s result: %s", batch_id, result.model_dump_json(indent=2)
+        )
+
+    # ΓöÇΓöÇ Step D: Single-batch shortcut ΓöÇΓöÇ
+    if len(batch_outputs) == 1:
+        only = batch_outputs[0]
+        elapsed = time.time() - start
+        logger.info(
+            "[Exhaustive] Single batch ΓÇö skipping reduce phase (%.2fs)", elapsed
+        )
+
+        if sio and sid:
+            await sio.emit(
+                "exhaustive_progress",
+                {"batch": total_batches, "total": total_batches, "status": "complete"},
+                room=sid,
+            )
+
+        return {
+            "answer": only.partial_answer,
+            "sources": {"documents_used": [], "web_used": []},
+            "confidence_score": only.confidence,
+            "exhaustive": True,
+            "exhaustive_meta": {
+                "total_batches": total_batches,
+                "total_documents": len(all_docs),
+                "elapsed_seconds": round(elapsed, 2),
+            },
+        }
+
+    # ΓöÇΓöÇ Step E: Reduce phase ΓöÇΓöÇ
+    if sio and sid:
+        await sio.emit(
+            "exhaustive_progress",
+            {
+                "batch": total_batches,
+                "total": total_batches,
+                "status": "Synthesizing final answerΓÇª",
+            },
+            room=sid,
+        )
+
+    logger.info(
+        "[Exhaustive] Starting reduce phase over %d batch outputs", len(batch_outputs)
+    )
+    final = await run_reduce_phase(batch_outputs, query)
+
+    elapsed = time.time() - start
+    logger.info(
+        "[Exhaustive] Complete in %.2fs ΓÇö confidence=%s",
+        elapsed,
+        final.overall_confidence,
+    )
+
+    if sio and sid:
+        await sio.emit(
+            "exhaustive_progress",
+            {"batch": total_batches, "total": total_batches, "status": "complete"},
+            room=sid,
+        )
+
+    return {
+        "answer": final.final_answer,
+        "sources": {"documents_used": [], "web_used": []},
+        "confidence_score": final.overall_confidence,
+        "exhaustive": True,
+        "exhaustive_meta": {
+            "total_batches": total_batches,
+            "total_documents": len(all_docs),
+            "key_consensus_points": final.key_consensus_points,
+            "resolved_contradictions": final.resolved_contradictions,
+            "elapsed_seconds": round(elapsed, 2),
+        },
+    }
