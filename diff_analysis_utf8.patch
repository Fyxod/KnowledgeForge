+"""
+Pydantic output schemas for the Exhaustive Analysis Mode.
+
+Map phase: ExhaustiveMapOutput ΓÇö structured findings from a single document batch.
+Reduce phase: ExhaustiveReduceOutput ΓÇö synthesized answer across all batches.
+"""
+
+from typing import List, Literal
+
+from core.llm.output_schemas.base import LLMOutputBase
+
+
+class ExhaustiveMapOutput(LLMOutputBase):
+    """Structured output from the MAP phase (one per document batch)."""
+
+    batch_id: str
+    key_findings: List[str]
+    supporting_evidence: List[str]
+    contradictions: List[str]
+    confidence: Literal["high", "medium", "low"]
+    partial_answer: str
+
+
+class ExhaustiveReduceOutput(LLMOutputBase):
+    """Structured output from the REDUCE phase (final synthesis)."""
+
+    final_answer: str
+    key_consensus_points: List[str]
+    resolved_contradictions: List[str]
+    overall_confidence: Literal["high", "medium", "low"]
