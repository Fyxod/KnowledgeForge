LOCAL_BASE_URL=http://localhost
CUDA_VISIBLE_DEVICES=0

# ── vLLM endpoints (used when REMOTE_GPU=False) ──────────────────────────────
# Main LLM: native vLLM support — `vllm serve openai/gpt-oss-20b`
# For 120B:  VLLM_MAIN_MODEL=openai/gpt-oss-120b  (requires multi-GPU or quantization)
# IMPORTANT: MAIN_MODEL (above) must match the --served-model-name in start_vllm.sh
VLLM_MAIN_URL=http://localhost:8000/v1
VLLM_VLM_URL=http://localhost:8001/v1
VLLM_MAIN_MODEL=openai/gpt-oss-20b
VLLM_VLM_MODEL=Qwen/Qwen2-VL-7B-Instruct-AWQ
VLLM_DRAFT_MODEL=
# gpt-oss-20b is ~40GB BF16 — use 0.85 on A6000 48GB. VLM gets remaining ~6GB.
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_VLM_GPU_MEMORY_UTILIZATION=0.13
VLLM_MAX_MODEL_LEN=131072