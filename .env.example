DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=bedrock
SECRET_KEY=thisbetterbesecretkey
API_KEY_1=DUMMY_KEY
API_KEY_2=DUMMY_KEY
API_KEY_3=DUMMY_KEY
API_KEY_4=DUMMY_KEY
API_KEY_5=DUMMY_KEY
API_KEY_6=DUMMY_KEY
TAVILY_API_KEY=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
OPENAI_API=DUMMY_KEY
QUERY_URL=https://llm.katiyar.xyz/query
REMOTE_GPU=False
USE_VISION_MODEL=True
VISION_URL=https://llm.katiyar.xyz/vision-query
# gpt-oss mode (default): set to the --served-model-name registered in start_vllm.sh
# qwen-unified mode:       set to Qwen/Qwen3.5-9B (must match VLLM_UNIFIED_MODEL)
MAIN_MODEL=gpt-oss:20b-50k-8k
LOCAL_BASE_URL=http://localhost
CUDA_VISIBLE_DEVICES=0

# ── vLLM mode selection ───────────────────────────────────────────────────────
#
# VLLM_MODE=gpt-oss (default)
#   Port 9000: openai/gpt-oss-20b MXFP4 (main LLM)
#   Port 9001: cyankiwi/Qwen3.5-9B-AWQ-4bit (VLM for OCR + visual QnA)
#   Port 8080: zai-org/GLM-OCR (structured document OCR)
#   MAIN_MODEL=gpt-oss:20b-50k-8k  (or whatever --served-model-name you set)
#
# VLLM_MODE=qwen-unified
#   Port 9000: Qwen/Qwen3.5-9B BF16 — handles BOTH text (LLM) and image (VLM) requests
#   Port 8080: zai-org/GLM-OCR (unchanged)
#   Port 9001: NOT used — Python routes VLM calls to port 9000 automatically
#   MAIN_MODEL=Qwen/Qwen3.5-9B  (must match VLLM_UNIFIED_MODEL)
#   Pros: One model, 128K context, potentially stronger reasoning (Qwen3.5 benchmarks well)
#   Cons: No specialised gpt-oss MoE efficiency; single-threaded for both tasks
#
VLLM_MODE=gpt-oss
# Model used in qwen-unified mode (BF16 full model, ~18 GB VRAM):
VLLM_UNIFIED_MODEL=Qwen/Qwen3.5-9B

# ── vLLM endpoints (used when REMOTE_GPU=False) ──────────────────────────────
#
# PREREQUISITE: Install vLLM in a dedicated venv (recommended):
#   python -m venv ~/vllm-venv && source ~/vllm-venv/bin/activate
#   uv pip install vllm --torch-backend=auto && deactivate
#
# Point start_vllm.sh to it (leave empty if vllm is on system PATH):
VLLM_VENV=~/vllm-venv
#
# MXFP4 quantization: gpt-oss-20b ships with MoE weights pre-quantized to MXFP4
# (~16 GB, not ~42 GB BF16). vLLM auto-detects the GPU and applies the correct backend.
#
# IMPORTANT: MAIN_MODEL must match the --served-model-name in start_vllm.sh
# gpt-oss mode: MAIN_MODEL=gpt-oss:20b-50k-8k  (or your chosen alias)
# qwen-unified: MAIN_MODEL=Qwen/Qwen3.5-9B     (must match VLLM_UNIFIED_MODEL)
# For 120B:  VLLM_MAIN_MODEL=openai/gpt-oss-120b  (requires multi-GPU)
VLLM_MAIN_URL=http://localhost:9000/v1
VLLM_VLM_URL=http://localhost:9001/v1
VLLM_MAIN_MODEL=openai/gpt-oss-20b
# Qwen3.5-9B is a full vision+text+reasoning model (handles OCR and visual QnA).
# AWQ 4-bit (~6 GB): safe for co-deployment, default.
# BF16 (Qwen/Qwen3.5-9B, ~18 GB): used in qwen-unified mode on port 9000.
VLLM_VLM_MODEL=cyankiwi/Qwen3.5-9B-AWQ-4bit
VLLM_DRAFT_MODEL=
# GLM-OCR: two-tier deployment managed by start_vllm.sh (both modes)
#   Port 8080: vLLM serves zai-org/GLM-OCR (~2 GB weights)
#   Port 5002: glmocr SDK server (PP-DocLayout-V3 layout detection + orchestration)
#   glm_ocr.py calls port 5002 — no code change needed.
VLLM_GLM_OCR_MODEL=zai-org/GLM-OCR
GLM_OCR_VLLM_PORT=8080
GLM_OCR_SDK_PORT=5002

# ── VRAM budget — VLLM_MODE=gpt-oss (default, 40 GB cap on A6000 48GB) ───────
# gpt-oss-20b MXFP4:  0.57 × 48 = 27.4 GB → ~16 GB weights + ~11.4 GB KV pool
#   KV estimate: 32 layers × 2 × 8 GQA heads × 128 dim × 2B ≈ 128 KB/token
#   ~90K token theoretical ceiling → 65536 (64K) is safe with buffer
# Qwen3.5-9B AWQ:     0.18 × 48 =  8.6 GB → ~6 GB weights + ~2.6 GB KV
# GLM-OCR 0.9B:       0.05 × 48 =  2.4 GB → ~2 GB weights
# OS/CUDA overhead:   ~1.5 GB
# Total:              38.4 GB + 1.5 GB = ~40 GB ✓
#
# For gpt-oss-20b alone (--main flag): raise to VLLM_GPU_MEMORY_UTILIZATION=0.85
# For VLM alone (--vlm flag): raise VLLM_VLM_GPU_MEMORY_UTILIZATION=0.85
#   optionally: VLLM_VLM_MODEL=Qwen/Qwen3.5-9B (BF16) + VLLM_VLM_MAX_MODEL_LEN=262144
VLLM_GPU_MEMORY_UTILIZATION=0.57
VLLM_MAX_MODEL_LEN=65536
VLLM_VLM_GPU_MEMORY_UTILIZATION=0.18
VLLM_VLM_MAX_MODEL_LEN=32768

# ── VRAM budget — VLLM_MODE=qwen-unified (40 GB cap on A6000 48GB) ───────────
# Qwen3.5-9B BF16:    0.75 × 48 = 36.0 GB → ~18 GB weights + ~18 GB KV pool
#   → 128K context (131072 tokens) — full Qwen3.5-9B context window
# GLM-OCR 0.9B:       0.05 × 48 =  2.4 GB → ~2 GB weights
# OS/CUDA overhead:   ~1.5 GB
# Total:              36.0 + 2.4 + 1.5 = ~39.9 GB ✓
# (Uncomment these to activate unified mode — also set VLLM_MODE=qwen-unified above)
# VLLM_UNIFIED_GPU_MEMORY_UTILIZATION=0.75
# VLLM_UNIFIED_MAX_MODEL_LEN=131072

# ── Optional overrides ───────────────────────────────────────────────────────
# VLLM_MAIN_APC=1     # Enable prefix caching for gpt-oss-20b (off by default per official docs)
# VLLM_MAIN_NO_APC=   # (deprecated, use VLLM_MAIN_APC=1 to enable instead)
