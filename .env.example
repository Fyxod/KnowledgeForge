# ── vLLM endpoints (used when REMOTE_GPU=False) ──────────────────────────────
#
# PREREQUISITE: gpt-oss-20b requires OpenAI's custom vLLM build, not standard vLLM:
#   uv pip install --pre "vllm==0.10.1+gptoss" \
#       --extra-index-url https://wheels.vllm.ai/gpt-oss/ \
#       --extra-index-url https://download.pytorch.org/whl/nightly/cu128 \
#       --index-strategy unsafe-best-match
#
# MXFP4 quantization: gpt-oss-20b ships with MoE weights pre-quantized to MXFP4
# (~16 GB, not ~40 GB BF16). This is loaded automatically by vLLM.
# On A6000 Ada (SM 8.9), vLLM falls back to Triton MXFP4 emulation (functional).
# Required env vars for Ada are set in scripts/start_vllm.sh automatically.
#
# IMPORTANT: MAIN_MODEL must match the --served-model-name in start_vllm.sh
# For 120B:  VLLM_MAIN_MODEL=openai/gpt-oss-120b  (requires multi-GPU)
VLLM_MAIN_URL=http://localhost:8000/v1
VLLM_VLM_URL=http://localhost:8001/v1
VLLM_MAIN_MODEL=openai/gpt-oss-20b
# Qwen3.5-9B is a full vision+text+reasoning model (handles OCR and visual QnA).
# AWQ 4-bit (~6 GB): safe for co-deployment, default.
# BF16 (Qwen/Qwen3.5-9B, ~18 GB): better quality, still fits thanks to MXFP4 savings.
VLLM_VLM_MODEL=cyankiwi/Qwen3.5-9B-AWQ-4bit
VLLM_DRAFT_MODEL=
# GLM-OCR: two-tier deployment managed by start_vllm.sh
#   Port 8080: vLLM serves the raw model (THUDM/glm-ocr, ~2 GB)
#   Port 5002: glmocr SDK server (PP-DocLayout-V3 layout detection + orchestration)
#   glm_ocr.py calls port 5002 — no code change needed.
VLLM_GLM_OCR_MODEL=THUDM/glm-ocr
GLM_OCR_VLLM_PORT=8080
GLM_OCR_SDK_PORT=5002

# ── VRAM budget on A6000 48GB (gpt-oss-20b MXFP4 + Qwen3.5-9B AWQ + GLM-OCR) ──
# VRAM budget: gpt-oss-20b MXFP4 + Qwen3.5-9B AWQ + GLM-OCR on 48 GB A6000
# gpt-oss-20b MXFP4: 0.72 × 48 GB = 34.6 GB → ~16 GB weights + ~18.6 GB KV pool
#   KV estimate: ~64 KB/token → 128K session = ~8 GB → ~2 concurrent 128K sessions
# Qwen3.5-9B AWQ:    0.18 × 48 GB =  8.6 GB → ~6 GB weights + ~2.6 GB KV
# GLM-OCR 0.9B:      ~2.0 GB (managed by glmocr SDK, separate process)
# OS/CUDA overhead:  ~1.5 GB
# Total:             ~46.7 GB ✓  (leaves ~1.3 GB margin on 48 GB)
#
# To run gpt-oss-20b alone (--main flag):
#   raise VLLM_GPU_MEMORY_UTILIZATION=0.85 for more KV headroom
# To run VLM alone (--vlm flag):
#   raise VLLM_VLM_GPU_MEMORY_UTILIZATION=0.85
#   optionally: VLLM_VLM_MODEL=Qwen/Qwen3.5-9B (BF16) + VLLM_VLM_MAX_MODEL_LEN=262144
# 40 GB VRAM cap across all models:
#   gpt-oss-20b:  0.57 × 48 = 27.4 GB → ~16 GB weights + ~11.4 GB KV pool
#   Qwen3.5-9B:   0.18 × 48 =  8.6 GB → ~6 GB weights + ~2.6 GB KV
#   GLM-OCR:      0.05 × 48 =  2.4 GB → ~2 GB weights
#   Total models: ~38.4 GB  +  ~1.5 GB OS  =  ~40 GB
#
# KV cache math for gpt-oss-20b (estimated: 32 layers × 2 × 8 GQA heads × 128 dim × 2B = 128 KB/token):
#   11.4 GB / 128 KB/token ≈ 90K token theoretical max → 65536 (64K) is safe with buffer.
#   For --main-only: raise VLLM_GPU_MEMORY_UTILIZATION=0.85, VLLM_MAX_MODEL_LEN=131072.
VLLM_GPU_MEMORY_UTILIZATION=0.57
VLLM_MAX_MODEL_LEN=65536
VLLM_VLM_GPU_MEMORY_UTILIZATION=0.18
VLLM_VLM_MAX_MODEL_LEN=32768

# ── Optional overrides ───────────────────────────────────────────────────────
# VLLM_MAIN_APC=1     # Enable prefix caching for gpt-oss-20b (off by default per official docs)
# VLLM_MAIN_NO_APC=   # (deprecated, use VLLM_MAIN_APC=1 to enable instead)
